    <rdfs:label xml:lang="ko">KRDS 원칙</rdfs:label>
    <rdfs:comment xml:lang="ko">KRDS UX Writing 3대 원칙</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://krds.go.kr/ontology/uxwriting#Agency">
    <rdfs:label xml:lang="ko">기관</rdfs:label>
    <rdfs:comment xml:lang="ko">공공기관 (정부24, 홈택스 등)</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://krds.go.kr/ontology/uxwriting#PatternRule">
    <rdfs:label xml:lang="ko">패턴 규칙</rdfs:label>
    <rdfs:comment xml:lang="ko">정규식 기반 문체 패턴 규칙</rdfs:comment>
  </owl:Class>
