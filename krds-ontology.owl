<rdf:RDF xmlns:ns0="http://krds.go.kr/ontology/uxwriting#" xmlns="http://krds.go.kr/ontology/uxwriting#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xml:base="http://krds.go.kr/ontology/uxwriting#">
  <owl:Ontology rdf:about="http://krds.go.kr/ontology/uxwriting">
    <rdfs:label>KRDS UX Writing 행정어 온톨로지</rdfs:label>
    <rdfs:comment>KRDS 3대 원칙(무번역·정보핵심화·심리적안전망) 기반 공공기관 행정어 지식 그래프</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>
  <owl:Class rdf:about="http://krds.go.kr/ontology/uxwriting#AdministrativeJargon">
    <rdfs:label xml:lang="ko">행정어</rdfs:label>
    <rdfs:comment xml:lang="ko">공공기관에서 사용되는 행정어·전문어·금지 표현</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://krds.go.kr/ontology/uxwriting#Replacement">
    <rdfs:label xml:lang="ko">대체어</rdfs:label>
    <rdfs:comment xml:lang="ko">KRDS 권장 대체 표현</rdfs:comment>
  </owl:Class>
