#!/usr/bin/env node
'use strict';

/**
 * bin/krds-lint — KRDS UX Writing 린터 CLI 래퍼
 * stdin 또는 파일을 받아 krds-lint.js 엔진으로 검사합니다.
 *
 * 사용법:
 *   echo "귀하" | node bin/krds-lint
 *   node bin/krds-lint ./텍스트.txt
 *   node bin/krds-lint --json ./텍스트.txt
 */

const path = require('path');
const fs = require('fs');
const KRDSLint = require(path.join(__dirname, '..', 'krds-lint.js'));

// ─── 인수 파싱 ────────────────────────────────────────────────────────────────
const args = process.argv.slice(2);
const jsonMode = args.includes('--json');
const helpMode = args.includes('--help') || args.includes('-h');
const files = args.filter(a => !a.startsWith('--'));

if (helpMode) {
  process.stdout.write([
    'krds-lint — KRDS UX Writing 린터',
    '',
    '사용법:',
    '  echo "텍스트" | krds-lint',
    '  krds-lint <파일경로>',
    '  krds-lint --json <파일경로>',
    '',
    '옵션:',
    '  --json   결과를 JSON 형식으로 출력',
    '  --help   이 도움말 표시',
    '',
  ].join('\n'));
  process.exit(0);
}

// ─── stdin 읽기 ───────────────────────────────────────────────────────────────
function readStdin() {
  return new Promise((resolve) => {
    let data = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', chunk => (data += chunk));
    process.stdin.on('end', () => resolve(data));
  });
}

// ─── 메인 ────────────────────────────────────────────────────────────────────
async function main() {
  let text;

  if (files.length > 0) {
    // 파일 모드
    const filePath = path.resolve(files[0]);
    if (!fs.existsSync(filePath)) {
      process.stderr.write('오류: 파일을 찾을 수 없습니다 — ' + filePath + '\n');
      process.exit(1);
    }
    text = fs.readFileSync(filePath, 'utf8');
  } else {
    // stdin 모드
    text = await readStdin();
  }

  if (!text.trim()) {
    process.stderr.write('오류: 검사할 텍스트가 없습니다.\n');
    process.exit(1);
  }

  const result = KRDSLint.lint(text);

  if (jsonMode) {
    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
  } else {
    process.stdout.write(KRDSLint.formatCLI(result) + '\n');
  }

  if (result.summary.errors > 0) {
    process.exit(1);
  }
}

main().catch(err => {
  process.stderr.write('내부 오류: ' + err.message + '\n');
  process.exit(1);
});
